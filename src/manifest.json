{
    "manifest_version": 3,
    "name": "TorchSploit",
    "version": "1.0.0",
    "author": "TheLuaFox86",
    "description": "A CodeTorch project script injector on chrome",
    "permissions": [
        "activeTab",
        "scripting" 
    ],
    "host_permissions": [
        "https://*/*"
    ],
    "content_scripts": [
        {
            "matches": ["https://*/*"],
            "js": ["inject.js"],
            "all_frames": true,
            "run_at": "document_end",
            "world": "MAIN"
        }
    ],
     "web_accessible_resources": [
        {
            "resources": ["lib/*", "sploits/*"],
            "matches": ["https://*/*"]
        }
  ],
  "key": ""
}